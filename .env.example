# Smart Loyalty – environment placeholders
# Copy values into smart-loyalty/.env (Prisma CLI) and/or smart-loyalty/.env.local (Next.js).
# Never commit real secrets.

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Smart Loyalty

# Prisma / Postgres (placeholders — Phase 1B.1 does not connect to a real DB)
DATABASE_URL="postgresql://prisma:prisma@127.0.0.1:5432/smart_loyalty_placeholder?schema=public"
DIRECT_URL="postgresql://prisma:prisma@127.0.0.1:5432/smart_loyalty_placeholder?schema=public"

