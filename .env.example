# Smart Loyalty – environment placeholders
# Copy values into smart-loyalty/.env (Prisma CLI / DB tests) and/or smart-loyalty/.env.local (Next.js).
# Never commit real secrets.

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Smart Loyalty

# Local disposable Docker Postgres (Phase 1B.2) — see smart-loyalty/docker-compose.db.yml
DATABASE_URL="postgresql://smart_loyalty:smart_loyalty_dev_only@127.0.0.1:54329/smart_loyalty_1b2?schema=public"
DIRECT_URL="postgresql://smart_loyalty:smart_loyalty_dev_only@127.0.0.1:54329/smart_loyalty_1b2?schema=public"

