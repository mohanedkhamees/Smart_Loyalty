# Placeholders only — copy to .env and/or .env.local. Never commit secrets.
# See also ../.env.example at the repository root.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Smart Loyalty

# Local disposable Docker Postgres (Phase 1B.2)
# Start with: npm run db:up
# docker-compose.db.yml maps host port 54329 → container 5432
DATABASE_URL="postgresql://smart_loyalty:smart_loyalty_dev_only@127.0.0.1:54329/smart_loyalty_1b2?schema=public"
DIRECT_URL="postgresql://smart_loyalty:smart_loyalty_dev_only@127.0.0.1:54329/smart_loyalty_1b2?schema=public"

